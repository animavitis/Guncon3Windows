<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Guncon3Console</RootNamespace>
    <AssemblyName>Guncon3Console</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12.0</LangVersion>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <!-- Keep the .pdb files - a crash on hardware nobody here can reproduce is worth
         a readable stack - but leave the XML documentation out of the published
         output. It exists for IntelliSense while working on the code, and next to a
         shipped exe it is 77 KB of nothing. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mapping.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guncon3.Core\Guncon3.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The maintained fork of Thomas Bleeker's WinUSBNet, which this project
         vendored until now. Same lineage, same MIT licence; it drops the WinForms
         device-notification listener this app never used and replaces the hand-written
         P/Invoke with source generators. -->
    <PackageReference Include="Nefarius.Drivers.WinUSB" Version="5.3.0" />
  </ItemGroup>

  <!-- Release build: dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true -->

</Project>
