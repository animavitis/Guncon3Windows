<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Guncon3Console</RootNamespace>
    <AssemblyName>Guncon3Console</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>12.0</LangVersion>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Calibration.cs" />
    <Compile Include="CalibrationWindow.cs" />
    <Compile Include="ConsoleLog.cs" />
    <Compile Include="GunSnapshot.cs" />
    <Compile Include="GunWorker.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="TetherScript\AbsMouseFeeder.cs" />
    <Compile Include="TetherScript\Enumerators.cs" />
    <Compile Include="TetherScript\HIDController.cs" />
    <Compile Include="TetherScript\KeyboardFeeder.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mapping.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GunconUSB\GunconUSB.csproj" />
    <ProjectReference Include="..\WinUSBNet\WinUSBNet.csproj" />
    <ProjectReference Include="..\Guncon3.Core\Guncon3.Core.csproj" />
  </ItemGroup>

  <!-- Release build: dotnet publish -c Release -r win-x64 -p:SelfContained=true -p:PublishSingleFile=true -->

</Project>
